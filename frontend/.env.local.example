# Copy to .env.local and fill in values

# Privy App ID — get from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Seesaw contract address on Monad Testnet (set after deploying)
NEXT_PUBLIC_SEESAW_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer private key (NEVER commit this — contracts/.env only)
# DEPLOYER_PRIVATE_KEY=0x...
